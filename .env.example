# Base de donnees MySQL (en local, via docker compose)
DB_NAME=cinetalk
DB_USER=root
DB_PWD=
DB_HOST=localhost
DB_PORT=3306
# Sur Scalingo, l'addon MySQL fournit SCALINGO_MYSQL_URL : les variables DB_* sont alors ignorees

# Secret de signature des jetons JWT (longue chaine aleatoire)
JWT_SECRET=change_moi_avec_une_cle_secrete_longue

# Port d'ecoute (Scalingo fournit PORT automatiquement)
PORT=8080

# Cle API TMDB pour le catalogue (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
